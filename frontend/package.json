{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"*.{ts,js,json}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.21.1",
    "cropperjs": "^2.3.1",
    "laravel-echo": "^2.6.3",
    "pinia": "^4.1.0",
    "pusher-js": "^8.6.0",
    "tailwindcss": "^4.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vue": "^3.5.44",
    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.1",
    "glob": "^14.0.6",
    "jsdom": "^29.1.1",
    "minimatch": "^11.0.9",
    "overrides": "^1.2.0",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.6",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.3.14"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch": "^11.0.9"
  }
}
