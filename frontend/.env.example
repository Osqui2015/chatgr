# The public URL of the SPA. Used for absolute links inside the PWA.
VITE_APP_URL=http://localhost:5173

# Laravel Reverb connection. The key is public; the secret never leaves the
# backend.
VITE_REVERB_APP_KEY=chat-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Habilita el service worker durante `npm run dev` para probar la PWA.
# Déjalo vacío en el día a día: cachea módulos y estorba al HMR.
VITE_PWA_DEV=
